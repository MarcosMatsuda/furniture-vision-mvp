{
  "expo": {
    "name": "Furniture Vision",
    "slug": "furniture-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "furniture-vision",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furniturevision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to photograph furniture",
        "NSPhotoLibraryUsageDescription": "We need photo access to import reference images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.furniturevision.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
